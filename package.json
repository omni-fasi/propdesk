{
  "name": "propdesk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local prop-firm style paper trading terminal with live market data, challenges, P&L calendar and journal.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.web.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "node --test --test-reporter=dot \"shared/**/*.test.ts\" \"server/test/**/*.test.ts\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
