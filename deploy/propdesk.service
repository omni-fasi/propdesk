[Unit]
Description=PropDesk trading server (paper broker — keeps stops, targets and rules running)
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/Projects/propdesk
ExecStart=/usr/bin/node server/src/index.ts
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=PROPDESK_PORT=4777
MemoryMax=700M

[Install]
WantedBy=default.target
